	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "instructorToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "studentToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "courseId1",
			"value": "1",
			"type": "string"
		},
		{
			"key": "courseId2",
			"value": "2",
			"type": "string"
		},
		{
			"key": "enrollmentId",
			"value": "1",
			"type": "string"
		}
	],
